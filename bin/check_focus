#!/bin/bash

cd "$(dirname "$0")/.."
focus_on=$(/usr/bin/defaults read com.apple.controlcenter "NSStatusItem VisibleCC FocusModes" 2> /dev/null)

quiet_path=$(python3 -c "import settings; print(settings.QUIET_PATH)")
quiet_script="./bin/quiet"
quiet_status=$(cat "$quiet_path")
if [[ ( $focus_on == 1  && $quiet_status == "" ) ||  ( $focus_on != 1  && $quiet_status != "" ) ]]; then
	"$quiet_script"
fi
